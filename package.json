    "postdb:migrate": "drizzle-kit migrate --config drizzle.demo.config.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fontsource-variable/alegreya": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "drizzle-orm": "^0.45.4",
    "email-reply-parser": "^2.3.9",
    "geist": "^1.8.1",
    "image-size": "^2.0.4",
    "imapflow": "^2.2.10",
    "jose": "^6.2.13",
    "leaflet": "^1.9.4",
    "mailparser": "^3.9.36",
    "next": "16.4.2",
    "nodemailer": "^10.0.16",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/leaflet": "^1.9.22",
