# ─────────────────────────────────────────────────────────────────────────────
# Casacast, demo version (branch `demo`).
#
# The public demo needs only the first three. Everything a visitor does happens in a sandbox
# of their own: photos stay in the database, Telegram is simulated, and a nightly job deletes
# all of it. The product version (branch `main`) has the full list of integrations.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres connection string.
#   Locally: docker compose up -d  (or any Postgres 16), then this default works.
#   On Vercel: the Neon connection string (Storage → Neon, or neon.tech → Connection string).
DATABASE_URL="postgres://postgres:postgres@localhost:5432/estate"

# Signs the session cookie. Any long random string: openssl rand -base64 32
SESSION_SECRET=""

# Protects the scheduled jobs (/api/cron/demo-reset at night, /api/cron/worker). Vercel Cron
# sends it automatically once it is set in the project. Any long random string.
CRON_SECRET=""

# ── Optional, for local use ─────────────────────────────────────────────────

# An admin account, to look at the back office with full rights locally. Leave both empty on
# the public demo: the login page then shows only "Try the demo".
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# The agency's real Telegram channel. With both set, the agency's listings post there for real;
# a visitor's sandbox is always simulated, whatever is set here. Create the bot with @BotFather
# and add it as an admin of the channel ("@public_channel" or a numeric "-100…" id).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Photo storage for the admin's uploads (sandbox photos always stay in the database).
# Without it, locally the admin's photos go to ./.uploads.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Agency mailbox, so the admin can answer enquiries by email (sandboxes' replies are simulated).
# Gmail: 2-step verification on, then an app password (Google Account → Security → App passwords).
MAIL_ADDRESS=""
MAIL_APP_PASSWORD=""

# Share of partner-portal (mock) calls that fail with a retryable error, 0 to 1. Default 0.3.
MOCK_PORTAL_FAILURE_RATE=""

# Base URL for canonical links, the sitemap and the feeds. On Vercel the production URL is
# used automatically; set it only for a custom domain.
SITE_URL=""
